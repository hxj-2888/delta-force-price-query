<!-- 三角洲行动 - 搜索 -->
<view class="container">
  <!-- 搜索输入 -->
  <view class="search-header">
    <view class="search-input-wrap">
      <input
        type="text"
        placeholder="输入物品名称搜索..."
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onSearch"
        focus="{{true}}"
        confirm-type="search"
      />
      <text class="search-clear" bindtap="onClear" wx:if="{{keyword}}">✕</text>
    </view>
    <text class="search-cancel" bindtap="onCancel">取消</text>
  </view>

  <!-- 搜索结果 -->
  <block wx:if="{{isSearching}}">
    <view class="loading-container" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">搜索中...</view>
    </view>

    <view wx:elif="{{searchResults.length === 0 && keyword}}">
      <view class="empty-container">
        <view class="empty-icon">-</view>
        <view class="empty-text">未找到 "{{keyword}}" 相关物品</view>
      </view>
    </view>

    <view wx:elif="{{searchResults.length > 0}}">
      <view style="padding:20rpx 32rpx;font-size:24rpx;color:#888">找到 {{searchResults.length}} 个结果</view>
      <view class="result-item fade-in" wx:for="{{searchResults}}" wx:key="id" bindtap="onOpenDetail" data-id="{{item.id}}">
        <view class="item-pic" style="width:80rpx;height:80rpx;margin-right:20rpx">
          <image src="{{item.pic}}" mode="aspectFit" wx:if="{{item.pic}}" />
          <text class="pic-placeholder" style="font-size:40rpx" wx:else>-</text>
        </view>
        <view class="item-info">
          <view class="item-name-row">
            <text class="item-name">{{item.name}}</text>
            <text class="item-grade" style="background:rgba(102,126,234,0.15);color:#667eea;font-size:20rpx;padding:4rpx 16rpx;border-radius:16rpx;margin-left:16rpx">{{item.catName}}</text>
          </view>
          <view class="item-price-row">
            <text class="item-price">¥{{item.priceText}}</text>
            <text class="item-change {{item.changeClass}}">{{item.changeText}}</text>
          </view>
        </view>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- 默认状态：搜索提示和快捷入口 -->
  <block wx:else>
    <!-- 搜索提示 -->
    <view class="search-hint">
      <view class="hint-title">搜索提示</view>
      <view class="hint-text">支持搜索物品名称关键词
例如：头盔、弹匣、钥匙、瞄具...</view>
    </view>

    <!-- 搜索历史 -->
    <view class="history-section" wx:if="{{searchHistory.length > 0}}">
      <view class="history-title">
        <text>搜索历史</text>
        <text class="history-clear" bindtap="onClearHistory">清空</text>
      </view>
      <view class="history-tags">
        <text class="history-tag" wx:for="{{searchHistory}}" wx:key="*this" bindtap="onSearchHistory" data-kw="{{item}}">{{item}}</text>
      </view>
    </view>

    <!-- 最近浏览 -->
    <view class="history-section" wx:if="{{recentViews.length > 0}}">
      <view class="history-title">
        <text>最近浏览</text>
        <text class="history-clear" bindtap="onClearRecent">清空</text>
      </view>
      <view wx:for="{{recentViews}}" wx:key="id" wx:for-item="rv">
        <view class="result-item" bindtap="onOpenDetail" data-id="{{rv.id}}">
          <view class="item-pic" style="width:80rpx;height:80rpx;margin-right:20rpx">
            <image src="{{rv.pic}}" mode="aspectFit" wx:if="{{rv.pic}}" />
            <text class="pic-placeholder" style="font-size:40rpx" wx:else>-</text>
          </view>
          <view class="item-info">
            <view class="item-name-row">
              <text class="item-name">{{rv.name}}</text>
              <text style="font-size:20rpx;color:#667eea;margin-left:12rpx">{{rv.catName}}</text>
            </view>
            <view class="item-price-row">
              <text class="item-price">¥{{rv.priceText}}</text>
              <text class="item-change {{rv.changeClass}}">{{rv.changeText}}</text>
            </view>
          </view>
          <text class="item-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 收藏（快速入口） -->
    <view class="history-section" wx:if="{{favorites.length > 0}}" style="padding-bottom:40rpx">
      <view class="history-title">
        <text>我的收藏</text>
      </view>
      <view wx:for="{{favorites}}" wx:key="id" wx:for-item="fav">
        <view class="result-item" bindtap="onOpenDetail" data-id="{{fav.id}}">
          <view class="item-pic" style="width:80rpx;height:80rpx;margin-right:20rpx">
            <image src="{{fav.pic}}" mode="aspectFit" wx:if="{{fav.pic}}" />
            <text class="pic-placeholder" style="font-size:40rpx" wx:else>-</text>
          </view>
          <view class="item-info">
            <view class="item-name-row">
              <text class="item-name">{{fav.name}}</text>
              <text style="font-size:20rpx;color:#667eea;margin-left:12rpx">{{fav.catName}}</text>
            </view>
            <view class="item-price-row">
              <text class="item-price">¥{{fav.priceText}}</text>
              <text class="item-change {{fav.changeClass}}">{{fav.changeText}}</text>
            </view>
          </view>
          <text class="item-arrow">›</text>
        </view>
      </view>
    </view>
  </block>
</view>
