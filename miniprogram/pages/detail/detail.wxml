<!-- 详情页 -->
<view class="nav-bar">
  <view class="nav-back" bindtap="goBack">‹ 返回</view>
  <view class="nav-title">物品详情</view>
  <view class="nav-actions">
    <text class="nav-action {{isFavorited ? 'favorited' : ''}}" bindtap="toggleFavorite">{{favBtnText}}</text>
    <text class="nav-action" bindtap="refreshItem">刷新</text>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <view class="loading-text">正在向API请求最新数据...</view>
</view>

<!-- 详情内容 -->
<view wx:else>
  <view class="detail-header">
    <view class="detail-pic">
      <image src="{{item.pic}}" mode="aspectFit" wx:if="{{item.pic}}"></image>
      <text wx:else style="font-size:36px">-</text>
    </view>
    <view class="detail-basic">
      <view class="detail-name">{{item.name}}</view>
      <view class="detail-meta">
        <text class="meta-tag" wx:if="{{item.secondClassCN}}">{{item.secondClassCN}}</text>
        <text class="meta-tag" wx:if="{{item.gradeText}}" style="color:{{item.gradeColor}}">{{item.gradeText}}</text>
      </view>
      <view class="detail-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
    </view>
  </view>

  <!-- 价格卡片 -->
  <view class="price-card">
    <view class="price-card-header">
      <text class="price-card-title">当前价格</text>
      <text class="price-card-time">更新于 {{item.updateTime}}</text>
    </view>
    <view class="price-main">
      <text class="price-currency">¥</text>
      <text class="price-value">{{item.priceFormatted}}</text>
    </view>
    <view class="price-sub">
      <view class="sub-item">
        <text class="sub-label">今日开盘</text>
        <text class="sub-value">¥{{item.openPrice}}</text>
      </view>
      <view class="sub-item">
        <text class="sub-label">今日涨跌</text>
        <text class="sub-value {{item.changeClass}}">{{item.changeFormatted}}</text>
      </view>
    </view>
  </view>

  <!-- 价格趋势 -->
  <view class="section">
    <view class="section-title">价格趋势</view>
    <view class="trend-cards">
      <view class="trend-card {{item.d3Active ? 'highlight' : ''}}">
        <text class="trend-card-label">近3天</text>
        <text class="trend-card-price">¥{{item.d3PriceFormatted}}</text>
        <text class="trend-card-change {{item.d3ChangeClass}}">{{item.d3ChangeFormatted}}</text>
      </view>
      <view class="trend-card {{item.d7Active ? 'highlight' : ''}}">
        <text class="trend-card-label">近7天</text>
        <text class="trend-card-price">¥{{item.d7PriceFormatted}}</text>
        <text class="trend-card-change {{item.d7ChangeClass}}">{{item.d7ChangeFormatted}}</text>
      </view>
      <view class="trend-card {{item.d30Active ? 'highlight' : ''}}">
        <text class="trend-card-label">近30天</text>
        <text class="trend-card-price">¥{{item.d30PriceFormatted}}</text>
        <text class="trend-card-change {{item.d30ChangeClass}}">{{item.d30ChangeFormatted}}</text>
      </view>
    </view>
  </view>

  <!-- 物品属性 -->
  <view class="section" wx:if="{{item.hasProps}}">
    <view class="section-title">物品属性</view>
    <view class="info-grid">
      <view class="info-item" wx:if="{{item.secondClassCN}}">
        <text class="info-label">分类</text>
        <text class="info-value">{{item.secondClassCN}}</text>
      </view>
      <view class="info-item" wx:if="{{item.sizeText}}">
        <text class="info-label">占格</text>
        <text class="info-value">{{item.sizeText}}</text>
      </view>
      <view class="info-item" wx:if="{{item.weightText}}">
        <text class="info-label">重量</text>
        <text class="info-value">{{item.weightText}} kg</text>
      </view>
      <view class="info-item" wx:if="{{item.gradeText}}">
        <text class="info-label">等级</text>
        <text class="info-value" style="color:{{item.gradeColor}}">{{item.gradeText}}</text>
      </view>
      <view class="info-item" wx:if="{{item.objectID}}">
        <text class="info-label">ID</text>
        <text class="info-value">{{item.objectID}}</text>
      </view>
    </view>
  </view>
</view>