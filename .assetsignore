# Cloudflare Pages 部署排除清单
# 只影响 pages deploy 上传内容, 不影响 git 跟踪
# (wrangler pages deploy 会同时尊重 .gitignore 与 .assetsignore)

# 本地开发/打包工具
server.js
installer.iss
setup.bat
start.bat
package-lock.json
installer/
dist/

# 构建工具与文档（仅本地/git 使用）
scripts/
README.md
DEPLOY.md

# 测试代码（仅本地/git 使用）
test/

# 小程序（独立部署，不走网页端）
miniprogram/
miniprogram.zip

# Cloudflare Cron Worker 独立部署
workers/
migrations/

# 仓库元数据
.github/
.gitignore
.gitattributes

# 系统垃圾
*.log
.DS_Store
Thumbs.db
